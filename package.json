{
  "name": "ira-icons",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": ["packages/*"],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "bun run --cwd packages/landing dev",
    "build": "bun run --cwd packages/landing build",
    "test": "bun run --cwd packages/react test",
    "package:build": "node packages/react/build-package.mjs",
    "package:pack": "bun run package:build && npm pack ./dist/npm --pack-destination ./dist",
    "preview": "bun run --cwd packages/landing preview"
  }
}
