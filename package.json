{
  "name": "ira-icons",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": ["packages/*"],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "bun run --cwd packages/landing dev",
    "build": "bun run --cwd packages/landing build",
    "test": "bun run --cwd packages/react test",
    "test:icon-tools": "node --test scripts/icon-studio/*.test.mjs packages/landing/test/generate-icon.test.mjs",
    "test:adapters": "bun run package:build && node --test scripts/npm-package/test-adapters.mjs",
    "package:build": "node packages/react/build-package.mjs",
    "package:pack": "bun run package:build && npm pack ./dist/npm --pack-destination ./dist",
    "preview": "bun run --cwd packages/landing preview"
  },
  "devDependencies": {
    "saxes": "^6.0.0",
    "svelte": "^5.58.1",
    "vue": "^3.5.46"
  }
}
