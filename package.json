{
  "name": "ira-icons",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "cd web && node --env-file-if-exists=../.env ../node_modules/astro/bin/astro.mjs dev",
    "build": "cd web && astro build",
    "build:vercel": "node scripts/vercel/build.ts",
    "build:standalone": "node scripts/standalone/build.ts",
    "test:standalone": "node scripts/standalone/build.ts --check",
    "typecheck": "cd web && astro sync && cd .. && tsc --noEmit && tsc -p scripts/npm-package/test-react/tsconfig.json && cd web && astro check",
    "test": "node --test scripts/npm-package/test-react/*.test.ts web/test/*.test.ts && tsc -p scripts/npm-package/test-react/tsconfig.json",
    "test:icon-tools": "node --test scripts/icon-studio/*.test.ts web/test/generate-icon.test.ts",
    "test:adapters": "bun run package:build && node --test scripts/npm-package/test-adapters.ts",
    "package:build": "node scripts/npm-package/build.ts",
    "package:pack": "bun run package:build && npm pack ./dist/npm-variants/all ./dist/npm-variants/react ./dist/npm-variants/astro ./dist/npm-variants/vue ./dist/npm-variants/svelte --pack-destination ./dist",
    "preview": "cd web && node --env-file-if-exists=../.env ../node_modules/astro/bin/astro.mjs preview"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.14",
    "@astrojs/vercel": "^11.0.22",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.12",
    "sharp": "^0.35.5",
    "svg-pathdata": "^8.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "saxes": "^6.0.0",
    "svelte": "^5.58.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-svgr": "^4.0.0",
    "vue": "^3.5.46"
  }
}
