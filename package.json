{
  "name": "ira-icons",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "cd web && node --env-file-if-exists=../.env ../node_modules/astro/bin/astro.mjs dev",
    "build": "cd web && astro build",
    "test": "node --test scripts/npm-package/test-react/*.test.mjs && tsc -p scripts/npm-package/test-react/tsconfig.json",
    "test:icon-tools": "node --test scripts/icon-studio/*.test.mjs web/test/generate-icon.test.mjs",
    "test:adapters": "bun run package:build && node --test scripts/npm-package/test-adapters.mjs",
    "package:build": "node scripts/npm-package/build.mjs",
    "package:pack": "bun run package:build && npm pack ./dist/npm-variants/all ./dist/npm-variants/react ./dist/npm-variants/astro ./dist/npm-variants/vue ./dist/npm-variants/svelte --pack-destination ./dist",
    "preview": "cd web && node --env-file-if-exists=../.env ../node_modules/astro/bin/astro.mjs preview"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.14",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.12",
    "sharp": "^0.35.5",
    "svg-pathdata": "^8.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "saxes": "^6.0.0",
    "svelte": "^5.58.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-svgr": "^4.0.0",
    "vue": "^3.5.46"
  }
}
