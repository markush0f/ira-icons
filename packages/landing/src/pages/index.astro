---
import Icon from '@ira-icons/astro';
import { iconNames } from '@ira-icons/astro/names';
import '../styles/global.css';

const sizes = [16, 24, 32];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Ira Icons: una colección de iconos SVG de trazo redondeado." />
    <title>Ira Icons</title>
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">Colección SVG</p>
        <h1>Ira Icons</h1>
        <p>Iconos de trazo redondeado para Astro, React y HTML.</p>
      </header>
      <section aria-labelledby="catalog-title">
        <h2 id="catalog-title">Catálogo</h2>
        <p>Compara los iconos a 16, 24 y 32 px.</p>
        <ul class="catalog">
          {iconNames.map((name) => (
            <li class="icon-card">
              <h3>{name}</h3>
              <div class="samples">
                {sizes.map((size) => (
                  <figure>
                    <div class="sample"><Icon name={name} size={size} /></div>
                    <figcaption>{size} px</figcaption>
                  </figure>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>
