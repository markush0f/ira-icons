---
import Icon from "@ira-icons/astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import BunLogo from "../assets/package-managers/bun.svg";
import NpmLogo from "../assets/package-managers/npm.svg";
import PnpmLogo from "../assets/package-managers/pnpm.svg";
import PnpmDarkLogo from "../assets/package-managers/pnpm_dark.svg";
import YarnLogo from "../assets/package-managers/yarn.svg";

const packageName = "@iradukunda/ira-library";
const managers = [
  { name: "Bun", logo: BunLogo, darkLogo: null, command: `bun add ${packageName}` },
  { name: "npm", logo: NpmLogo, darkLogo: null, command: `npm install ${packageName}` },
  { name: "pnpm", logo: PnpmLogo, darkLogo: PnpmDarkLogo, command: `pnpm add ${packageName}` },
  { name: "Yarn", logo: YarnLogo, darkLogo: null, command: `yarn add ${packageName}` },
];
---

<SiteLayout title="Installation · Ira Icons" description="Choose a package manager for Ira Icons.">
  <main class="installation">
    <a class="back-link" href="/">
      <Icon name="arrow-left-minimalist" size={16} />
      Back to icons
    </a>
    <div class="package-picker" data-package-picker>
      <fieldset>
        <legend class="visually-hidden">Package manager</legend>
        <div class="options">
          {managers.map(({ name, logo, darkLogo, command }, index) => (
            <label>
              <input class="visually-hidden" type="radio" name="package-manager" value={command} checked={index === 0} />
              <span class="option">
                <img class:list={[{ "light-logo": darkLogo }]} src={logo.src} alt="" width="20" height="20" />
                {darkLogo && <img class="dark-logo" src={darkLogo.src} alt="" width="20" height="20" />}
                {name}
              </span>
            </label>
          ))}
        </div>
      </fieldset>
      <pre><output aria-label="Install command"><code><span class="command-tool" data-command-tool>bun</span>{" "}<span data-command-action>add</span>{" "}<span class="command-package">{packageName}</span></code></output></pre>
    </div>
  </main>
</SiteLayout>

<script>
  const picker = document.querySelector("[data-package-picker]");
  const tool = picker?.querySelector("[data-command-tool]");
  const action = picker?.querySelector("[data-command-action]");
  const syncCommand = () => {
    const selected = picker?.querySelector<HTMLInputElement>("input:checked");
    if (!selected || !tool || !action) return;
    const [toolName, actionName] = selected.value.split(" ");
    tool.textContent = toolName;
    action.textContent = actionName;
  };
  picker?.addEventListener("change", syncCommand);
  window.addEventListener("pageshow", syncCommand);
  syncCommand();
</script>

<style>
  .installation { max-width: 40rem; }
  .back-link { display: inline-flex; align-items: center; gap: .5rem; margin-bottom: 1rem; font-size: .85rem; }
  .back-link:hover { color: var(--accent); text-decoration: underline; text-underline-offset: .25em; }
  .package-picker { background: var(--panel); border: 1px solid var(--line); border-radius: .75rem; }
  fieldset { margin: 0; padding: .5rem; border: 0; min-inline-size: 0; }
  .options { display: flex; flex-wrap: wrap; gap: .25rem; }
  .option { display: flex; align-items: center; gap: .45rem; padding: .5rem .6rem; min-height: 2.5rem; border: 1px solid transparent; border-radius: .45rem; cursor: pointer; font-size: .8rem; }
  .option:hover { background: var(--hover); }
  input:checked + .option { border-color: var(--accent); }
  input:focus-visible + .option { outline: 2px solid var(--text); outline-offset: 1px; }
  img { object-fit: contain; }
  .light-logo, :global(:root[data-theme="light"]) .dark-logo { display: none; }
  :global(:root[data-theme="light"]) .light-logo { display: block; }
  pre { margin: 0; padding: .85rem 1rem; border-top: 1px solid var(--line); white-space: pre-wrap; overflow-wrap: anywhere; }
  code { font: .85rem/1.6 var(--font-mono); }
  .command-tool { color: var(--accent); }
  .command-package { color: #8bdac3; }
  :global(:root[data-theme="light"]) .command-package { color: #12664f; }
</style>
