---
import Icon from "@ira-icons/astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { CREATE_COMING_SOON } from "../lib/feature-flags.mjs";

const styles = [
  { id: "original", label: "Original", sample: "lightbulb" },
  { id: "minimalist", label: "Minimalist", sample: "lightbulb-minimalist" },
  { id: "animated", label: "Animated", sample: "lightbulb-animated" },
];
---

<SiteLayout
  title="Create an icon · Ira Icons"
  description="Draft a prompt for an AI-assisted SVG icon and explore the Ira Icons styles."
>
  <main class="studio" data-icon-studio={CREATE_COMING_SOON ? undefined : ""}>
    <a class="back-link" href="/">
      <Icon name="arrow-left-minimalist" size={15} />
      Back to catalog
    </a>

    <header class="studio-heading">
      <h1>Create an icon</h1>
      <p>{CREATE_COMING_SOON
        ? "A first look at the AI icon studio."
        : "Describe an SVG icon, choose a style, and generate it with Gemini."}</p>
    </header>

    {CREATE_COMING_SOON && (
      <aside class="coming-soon-banner" aria-labelledby="coming-soon-title">
        <Icon name="clock-minimalist" size={21} />
        <div>
          <h2 id="coming-soon-title">Coming soon</h2>
          <p>You can look around, but the icon studio isn’t open for editing yet.</p>
        </div>
      </aside>
    )}

    <div class="studio-grid" inert={CREATE_COMING_SOON}>
      <section class="editor" aria-labelledby="brief-title">
        <h2 id="brief-title">Icon brief</h2>

        <div class="prompt-heading">
          <label for="icon-prompt">Description</label>
          <span data-prompt-count aria-hidden="true">0 / 400</span>
        </div>
        <textarea
          id="icon-prompt"
          rows="5"
          maxlength="400"
          disabled={CREATE_COMING_SOON}
          placeholder="A small desk lamp with a pull cord. Show a soft glow when it turns on."
          aria-describedby="prompt-hint"
        ></textarea>
        <p id="prompt-hint" class="hint">Your draft stays in this browser until you press Generate. Then your description is sent to Gemini.</p>

        <fieldset disabled={CREATE_COMING_SOON}>
          <legend>Style</legend>
          <div class="style-options">
            {styles.map(({ id, label }, index) => (
              <label>
                <input type="radio" class="visually-hidden" name="icon-style" value={id} checked={index === 0} />
                <span>{label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="studio-actions">
          <button type="button" class="action" data-generate-icon disabled aria-describedby="provider-note">
            <Icon name="star-minimalist" size={17} />
            Generate with AI
          </button>
          <button type="button" class="action" data-copy-brief hidden={!CREATE_COMING_SOON} disabled>
            <Icon name="copy-minimalist" size={16} />
            Copy brief
          </button>
        </div>
        <p class="hint" id="provider-note">Powered by Gemini. Generated icons are not added to the catalog.</p>
        <p class="hint" data-brief-status role="status"></p>
      </section>

      <section class="preview" aria-labelledby="preview-title">
        <h2 id="preview-title" data-preview-title>Reference preview</h2>
        <p class="hint" data-preview-hint>This is a catalog example until you generate your own icon.</p>
        <div class="preview-grid" data-preview-grid>
          {styles.map(({ id, sample }, index) => (
            <figure data-style-preview={id} hidden={index !== 0}>
              <Icon name={sample} size={96} />
              <figcaption>{sample}.svg</figcaption>
            </figure>
          ))}
          <figure data-generated-preview hidden>
            <img width="96" height="96" alt="Generated icon" />
            <figcaption data-generated-caption></figcaption>
          </figure>
          <div class="preview-loader" data-preview-loader hidden aria-hidden="true">
            <div class="loader-mark">
              <Icon name="star-minimalist" size={21} />
            </div>
            <span>Generating icon…</span>
          </div>
          <span aria-hidden="true" class="preview-scale">24 × 24</span>
        </div>
        <p class="hint generation-status" data-generation-status role="status"></p>
        <a class="action download-result" data-download-icon hidden download>Download SVG</a>
      </section>
    </div>
  </main>
  <script src="../scripts/icon-studio.js"></script>
</SiteLayout>

<style>
  .studio {
    max-width: 68rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .back-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .studio-heading {
    margin: 1.25rem 0 1.65rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.7rem, 5vw, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.06em;
    font-weight: 650;
  }

  .studio-heading p {
    max-width: 65ch;
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .coming-soon-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--hover);
  }

  .coming-soon-banner svg {
    flex: none;
    color: var(--muted);
  }

  .coming-soon-banner p {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .studio-grid[inert] {
    filter: grayscale(1);
    opacity: 0.55;
  }

  .studio-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
  }

  .editor, .preview {
    min-width: 0;
    padding: clamp(0.9rem, 3vw, 1.35rem);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--panel);
  }

  h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 650;
  }

  .hint {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.55;
  }

  [data-brief-status]:empty {
    margin: 0;
  }

  .prompt-heading {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 1.2rem 0 0.45rem;
    font-size: 0.78rem;
  }

  [data-prompt-count] {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  textarea {
    display: block;
    width: 100%;
    min-height: 8rem;
    padding: 0.75rem;
    resize: vertical;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: var(--page);
    color: var(--text);
    font: 0.82rem/1.6 var(--font-mono);
  }

  textarea::placeholder {
    color: var(--muted);
  }

  fieldset {
    min-inline-size: 0;
    margin: 1.2rem 0 1.4rem;
    padding: 0;
    border: 0;
  }

  legend {
    margin-bottom: 0.45rem;
    padding: 0;
    font-size: 0.78rem;
  }

  .style-options, .studio-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .style-options span, .action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.4rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: var(--page);
    color: var(--text);
    font-size: 0.76rem;
    cursor: pointer;
  }

  .style-options input:checked + span,
  .action:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .style-options input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .action:disabled {
    color: var(--muted);
    cursor: not-allowed;
  }

  .preview-grid {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 15rem;
    margin-top: 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: radial-gradient(circle, var(--line) 1px, transparent 1px) center / 16px 16px var(--page);
  }

  .generation-status:empty {
    margin: 0;
  }

  [data-generated-preview] img {
    box-sizing: content-box;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: #f6f4f9;
  }

  .download-result {
    margin-top: 0.6rem;
  }

  .preview-loader {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .loader-mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.5rem;
    aspect-ratio: 1;
    color: var(--accent);
  }

  .loader-mark::before {
    position: absolute;
    inset: 0;
    border: 2px solid var(--line);
    border-top-color: var(--accent);
    border-radius: 50%;
    content: "";
  }

  @media (prefers-reduced-motion: no-preference) {
    .loader-mark::before {
      animation: studio-wait 0.85s linear infinite;
    }

    @keyframes studio-wait {
      to { transform: rotate(1turn); }
    }
  }

  figure {
    display: grid;
    justify-items: center;
    gap: 0.65rem;
    margin: 0;
    color: var(--accent);
  }

  figcaption, .preview-scale {
    color: var(--muted);
    font-size: 0.69rem;
  }

  .preview-scale {
    position: absolute;
    right: 0.65rem;
    bottom: 0.55rem;
  }

  @media (max-width: 44rem) {
    .studio-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
