---
import Icon from "@ira-icons/astro";
import ColorPicker from "./ColorPicker.astro";
import IconCopy from "./IconCopy.astro";

interface Props {
  name: string;
}

const { name } = Astro.props;
---

<aside class="detail-panel" id="detail-panel" aria-labelledby="detail-title">
  <div class="detail-header">
    <p class="detail-eyebrow">Icon details</p>
  </div>
  <div class="detail-preview" id="detail-preview"><Icon name={name} size={96} color="#ad8af3" /></div>
  <h2 class="detail-title" id="detail-title">{name}</h2>
  <ColorPicker />
  <IconCopy />
</aside>
