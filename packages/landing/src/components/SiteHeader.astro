<header class="site-header">
  <a class="brand" href="/" aria-label="Ira Icons home">
    <img src="/ira-logo.png" alt="" width="65" height="65" />
    <span>Ira Icons</span>
  </a>

  <div class="header-actions">
    <a class="installation-link" href="/installation" aria-label="Installation">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        color="#ad8af3"
        aria-hidden="true"
      >
        <path d="M12 4v11m-5-5 5 5 5-5M5 20h14" />
      </svg>
    </a>
    <button
      type="button"
      class="theme-button"
      id="theme-toggle"
      aria-label="Toggle color theme"
      aria-pressed="false"
      hidden
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <path
          d="M20.5 14.4A8.7 8.7 0 0 1 9.6 3.5 8.7 8.7 0 1 0 20.5 14.4Z"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  </div>
</header>
