---
import Icon from "@ira-icons/astro";
import GitHubLogo from "../assets/frameworks/github.svg";

const onCatalog = Astro.url.pathname === "/";
const onInstallation = /^\/installation\/?$/.test(Astro.url.pathname);
const onCreate = /^\/create\/?$/.test(Astro.url.pathname);
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Ira Icons home">
    <img src="/ira-logo.png" alt="" width="65" height="65" />
    <span>Ira Icons</span>
  </a>

  <div class="header-actions">
    <a
      class="catalog-nav-link"
      href="/"
      aria-label="Icon catalog"
      data-astro-prefetch={onCatalog ? undefined : "hover"}
      aria-current={onCatalog ? "page" : undefined}
    >
      <Icon name="grid-minimalist" size={17} />
      <span class="nav-label">Catalog</span>
    </a>
    <a
      class="create-link"
      href="/create"
      aria-label="Create an icon"
      data-astro-prefetch={onCreate ? undefined : "hover"}
      aria-current={onCreate ? "page" : undefined}
    >
      <Icon name="star-minimalist" size={17} />
      <span class="nav-label">Create</span>
    </a>
    <a
      class="installation-link"
      href="/installation"
      aria-label="Installation guide"
      data-astro-prefetch={onInstallation ? undefined : "hover"}
      aria-current={onInstallation ? "page" : undefined}
    >
      <Icon name="download" size={17} />
      <span class="nav-label">Install</span>
    </a>
    <a
      class="github-link"
      href="https://github.com/markush0f/ira-icons"
      aria-label="Ira Icons on GitHub"
      target="_blank"
    >
      <img src={GitHubLogo.src} alt="" width="19" height="19" />
    </a>
    <button
      type="button"
      class="theme-button"
      id="theme-toggle"
      aria-label="Toggle color theme"
      aria-pressed="false"
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <path
          d="M20.5 14.4A8.7 8.7 0 0 1 9.6 3.5 8.7 8.7 0 1 0 20.5 14.4Z"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  </div>
</header>
