---
import { getSource } from './icons.mjs';
const { name, size = 24, color = 'currentColor', label } = Astro.props;
const source = getSource(name);
if (!source) throw new Error(`Unknown Ira Icons icon: ${name}`);
// Only trusted, checked-in SVGs enter the server catalog. Preserve their native viewBox and styling.
const [, root, drawing] = source.trim().match(/^<svg\b([^>]+)>([\s\S]*)<\/svg>$/);
const attrs = Object.fromEntries([...root.matchAll(/([^\s=]+)="([^"]*)"/g)].map(([,k,v])=>[k,v]));
const accessibleLabel = typeof label === 'string' ? label.trim() : '';
---
<svg {...attrs} width={size} height={size} color={color} role={accessibleLabel ? 'img' : undefined} aria-label={accessibleLabel || undefined} aria-hidden={accessibleLabel ? undefined : 'true'} set:html={drawing} />
