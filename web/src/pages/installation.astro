---
import Icon from "../icons/Icon.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import CodeSnippet from "../components/CodeSnippet.astro";
import AnimationDemo from "../components/AnimationDemo.astro";
import InstallationExample from "../components/InstallationExample.astro";
import InstallationIntro from "../components/InstallationIntro.astro";
import ReactLogo from "../assets/frameworks/react.svg";
import AstroLogo from "../assets/frameworks/astro.svg";
import NextLogo from "../assets/frameworks/nextjs.svg";
import VueLogo from "../assets/frameworks/vue.svg";
import SvelteLogo from "../assets/frameworks/svelte.svg";
import BunLogo from "../assets/package-managers/bun.svg";
import NpmLogo from "../assets/package-managers/npm.svg";
import PnpmLogo from "../assets/package-managers/pnpm.svg";
import PnpmDarkLogo from "../assets/package-managers/pnpm_dark.svg";
import YarnLogo from "../assets/package-managers/yarn.svg";
import { localeFromPath, localizePath, pageTitle, t } from "../i18n/index.ts";

const locale = localeFromPath(Astro.url.pathname);
const packageName = "@ira/iraicons";
const reactPackage = `${packageName}-react`;
const managers = [
  { name: "npm", logo: NpmLogo, command: "npm install" },
  { name: "Bun", logo: BunLogo, command: "bun add" },
  {
    name: "pnpm",
    logo: PnpmLogo,
    darkLogo: PnpmDarkLogo,
    command: "pnpm add",
  },
  { name: "Yarn", logo: YarnLogo, command: "yarn add" },
];

const searchLabel = t(locale, "install.example.search");
const reactExample = `import { SearchMinimalist } from '${reactPackage}';

export default function SearchButton() {
  return (
    <button type="button" aria-label="${searchLabel}">
      <SearchMinimalist size={24} />
    </button>
  );
}`;

const astroExample = `---
import SearchMinimalist from '${packageName}-astro/search-minimalist';
---

<button type="button" aria-label="${searchLabel}">
  <SearchMinimalist size={24} />
</button>`;

const nextExample = `import SearchMinimalist from '${reactPackage}/search-minimalist';

export default function Page() {
  return <SearchMinimalist size={24} label="${searchLabel}" />;
}`;

const vueExample = `<script setup>
import { SearchMinimalist } from '${packageName}-vue';
</script>

<template>
  <SearchMinimalist :size="24" label="${searchLabel}" />
</template>`;

const svelteExample = `<script>
  import { SearchMinimalist } from '${packageName}-svelte';
</script>

<SearchMinimalist size={24} label="${searchLabel}" />`;

const htmlExample = `<button type="button" aria-label="${searchLabel}">
  <img src="/icons/search-minimalist.svg"
       width="24" height="24" alt="">
</button>`;

const directExample = `import SearchMinimalist from '${reactPackage}/search-minimalist';

export default function SearchIcon() {
  return <SearchMinimalist size={24} label="${searchLabel}" />;
}`;
const dynamicExample = `import Icon from '${reactPackage}';

export function ActionIcon({ iconName }) {
  return <Icon name={iconName} size={24} />;
}`;
const props = [
  { name: 'name', fallback: t(locale, 'docs.props.required'), detail: 'docs.props.iconName' },
  { name: 'size', fallback: '24', detail: 'docs.props.size' },
  { name: 'color', fallback: 'currentColor', detail: 'docs.props.color' },
  { name: 'label', fallback: '—', detail: 'docs.props.label' },
  { name: 'speed', fallback: '1', detail: 'docs.props.speed' },
  { name: 'constant', fallback: 'true', detail: 'docs.props.constant' },
] as const;

const variants = [
  { name: "search", label: t(locale, "variant.original") },
  { name: "search-minimalist", label: t(locale, "variant.minimalist") },
  { name: "search-animated", label: t(locale, "variant.animated") },
];
---

<SiteLayout
  title={pageTitle(t(locale, "meta.install.title"))}
  description={t(locale, "meta.install.description")}
>
  <main class="installation">
    <aside class="docs-sidebar">
      <nav aria-labelledby="docs-index-title">
        <p id="docs-index-title">{t(locale, "docs.index")}</p>
        <ul>
          <li><a href="#install-title">{t(locale, "docs.install")}</a></li>
          <li><a href="#usage">{t(locale, "docs.usage")}</a></li>
          <li><a href="#customize-title">{t(locale, "install.style.title")}</a></li>
          <li><a href="#reference">{t(locale, "docs.reference")}</a></li>
        </ul>
      </nav>
    </aside>
    <div class="docs-content">
    <InstallationIntro packageName={packageName}>
      <div class="examples" data-install-examples>
        <InstallationExample id="react" title="React">
          <img slot="icon" src={ReactLogo.src} width="22" height="20" alt="" />
          <p slot="description">
            {t(locale, "install.react.lead")} <code>{reactPackage}</code>{t(locale, "install.react.end")}
          </p>
          <CodeSnippet
            title="SearchButton.jsx"
            code={reactExample}
            lang="jsx"
          />
        </InstallationExample>

        <InstallationExample id="astro" title="Astro">
          <img
            slot="icon"
            class="astro-framework-logo"
            src={AstroLogo.src}
            width="17"
            height="21"
            alt=""
          />
          <p slot="description">
            {t(locale, "install.astro.lead")} <code>.astro</code>{t(locale, "install.astro.mid")}<code>client:*</code>{t(locale, "install.astro.end")}
          </p>
          <CodeSnippet
            title="SearchButton.astro"
            code={astroExample}
            lang="astro"
          />
        </InstallationExample>

        <InstallationExample id="next" title="Next.js">
          <img
            slot="icon"
            class="next-framework-logo"
            src={NextLogo.src}
            width="20"
            height="20"
            alt=""
          />
          <p slot="description">
            {t(locale, "install.next.lead")}<code>'use client'</code>{t(locale, "install.next.end")}
          </p>
          <CodeSnippet title="app/page.jsx" code={nextExample} lang="jsx" />
        </InstallationExample>

        <InstallationExample id="vue" title="Vue 3">
          <img slot="icon" src={VueLogo.src} width="22" height="19" alt="" />
          <p slot="description">
            {t(locale, "install.vue.lead")}<code>&lt;script setup&gt;</code>{t(locale, "install.vue.end")}
          </p>
          <CodeSnippet title="SearchIcon.vue" code={vueExample} lang="vue" />
        </InstallationExample>

        <InstallationExample id="svelte" title="Svelte 5">
          <img slot="icon" src={SvelteLogo.src} width="17" height="21" alt="" />
          <p slot="description">
            {t(locale, "install.svelte.lead")}<code>.svelte</code>{t(locale, "install.svelte.end")}
          </p>
          <CodeSnippet
            title="SearchIcon.svelte"
            code={svelteExample}
            lang="svelte"
          />
        </InstallationExample>

        <InstallationExample id="svg" title="HTML / SVG">
          <Icon slot="icon" name="svg" size={23} />
          <p slot="description">
            {t(locale, "install.svg.lead")}<code>node_modules/{packageName}/icons/search-minimalist.svg</code>{t(locale, "install.svg.mid")}<code>icons/</code>{t(locale, "install.svg.afterFolder")}<strong>{t(locale, "install.svg.action")}</strong>{t(locale, "install.svg.end")}
          </p>
          <CodeSnippet title="index.html" code={htmlExample} lang="html" />
        </InstallationExample>
      </div>

      <div class="guide-section package-section">
      <header>
        <h3>{t(locale, "install.packages.title")}</h3>
        <p>{t(locale, "install.packages.lead")}</p>
      </header>

      <fieldset data-package-options hidden>
        <legend class="visually-hidden">{t(locale, "install.manager")}</legend>
        <div class="options">
          {managers.map(({ name, logo, darkLogo, command }, index) => (
            <label>
              <input
                class="visually-hidden"
                type="radio"
                name="package-manager"
                value={command}
                checked={index === 0}
              />
              <span class="option">
                <img
                  class:list={[{ "light-logo": darkLogo }]}
                  src={logo.src}
                  alt=""
                  width="18"
                  height="18"
                />
                {darkLogo && (
                  <img
                    class="dark-logo"
                    src={darkLogo.src}
                    alt=""
                    width="18"
                    height="18"
                  />
                )}
                {name}
              </span>
            </label>
          ))}
        </div>
      </fieldset>
      <div data-install-command data-package-base={packageName}>
        <CodeSnippet title="Terminal" code={`${managers[0].command} ${reactPackage}`} live />
      </div>
      <p class="note">
        {t(locale, "install.packages.beforeName")}<code>{packageName}</code>{t(locale, "install.packages.beforePath")}<code>{packageName}/astro</code>{t(locale, "install.packages.beforeCommand")}<code>bun run package:pack</code>{t(locale, "install.packages.beforeTgz")}<code>.tgz</code>{t(locale, "install.packages.end")}
      </p>
      </div>
    </InstallationIntro>

    <section class="guide-section doc-chapter usage-chapter" aria-labelledby="usage">
      <header><h2 id="usage">{t(locale, "docs.usage")}</h2></header>
      <div class="topic">
        <h3>{t(locale, "docs.direct")}</h3>
        <p>{t(locale, "docs.direct.body")}</p>
        <CodeSnippet title="React · SearchMinimalist" code={directExample} lang="jsx" />
      </div>
      <div class="topic">
        <h3>{t(locale, "docs.dynamic")}</h3>
        <p>{t(locale, "docs.dynamic.body")}</p>
        <CodeSnippet title="React · Icon" code={dynamicExample} lang="jsx" />
      </div>
      <div class="topic">
        <h3>{t(locale, "docs.svg")}</h3>
        <p>{t(locale, "docs.svg.body")}</p>
        <CodeSnippet title="HTML" code={htmlExample} lang="html" />
      </div>
    </section>

    <section class="guide-section doc-chapter" aria-labelledby="customize-title">
      <header>
        <h2 id="customize-title">{t(locale, "install.style.title")}</h2>
        <p>{t(locale, "install.style.lead")}</p>
      </header>

      <ul class="variants">
        {variants.map(({ name, label }) => (
          <li>
            <Icon name={name} size={28} constant={false} />
            <div>
              <strong>{label}</strong>
              <code>{name}</code>
            </div>
          </li>
        ))}
      </ul>

      <p class="note">
        {t(locale, "install.versions.lead")}<code>0.2.0</code>{t(locale, "install.versions.mid")}<code>0.3.0</code>{t(locale, "install.versions.end")}
      </p>

      <div class="topic">
        <h3>{t(locale, "docs.demo")}</h3>
        <p>{t(locale, "docs.demo.body")}</p>
        <AnimationDemo />
      </div>
    </section>

    <section class="guide-section doc-chapter" aria-labelledby="reference">
      <header><h2 id="reference">{t(locale, "docs.reference")}</h2></header>
      <table class="props" aria-labelledby="reference">
        <thead><tr>
          <th scope="col">{t(locale, "docs.props.name")}</th>
          <th scope="col">{t(locale, "docs.props.default")}</th>
          <th scope="col">{t(locale, "docs.props.effect")}</th>
        </tr></thead>
        <tbody>
          {props.map(({ name, fallback, detail }) => (
            <tr><th scope="row"><code>{name}</code></th><td>{name === 'name' ? fallback : <code>{fallback}</code>}</td><td>{t(locale, detail)}</td></tr>
          ))}
        </tbody>
      </table>
      <dl class="tips">
        <div>
          <dt>{t(locale, "install.tip.a11y")}</dt>
          <dd>
            {t(locale, "install.a11y.lead")}<code>label</code>{t(locale, "install.a11y.mid")}<code>alt</code>{t(locale, "install.a11y.end")}
          </dd>
        </div>
      </dl>

      <a class="catalog-link" href={localizePath("/", locale)}>
        {t(locale, "install.browse")}
        <Icon name="arrow-right-minimalist" size={16} />
      </a>
    </section>
    </div>
  </main>
</SiteLayout>

<script src="../scripts/installation.ts"></script>

<style>
  .installation {
    display: grid;
    --docs-tint: color-mix(in srgb, var(--accent) 8%, var(--panel));
    --docs-edge: color-mix(in srgb, var(--accent) 24%, var(--line));
    grid-template-columns: clamp(13rem, 16vw, 16rem) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
    max-width: 106rem;
    padding-bottom: 4rem;
  }

  .docs-content { min-width: 0; }

  .docs-sidebar {
    position: sticky;
    inset-block-start: calc(var(--site-header-height) + 2rem);
    padding-inline-end: 1rem;
    border-inline-end: 1px solid var(--docs-edge);
  }

  .docs-sidebar p {
    margin: 0 0 0.45rem;
    padding-inline: 0.65rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .docs-sidebar ul { display: grid; gap: 0.15rem; margin: 0; padding: 0; list-style: none; }
  .docs-sidebar a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.4rem 0.65rem;
    border-radius: 0.4rem;
    color: var(--text);
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .docs-sidebar a:hover,
  .docs-sidebar a:focus-visible,
  .installation:has(#install-title:target) a[href="#install-title"],
  .installation:has(#usage:target) a[href="#usage"],
  .installation:has(#customize-title:target) a[href="#customize-title"],
  .installation:has(#reference:target) a[href="#reference"] {
    background: var(--docs-tint);
    color: var(--accent);
  }

  @media (min-width: 75rem) {
    .usage-chapter { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.5rem; }
    .usage-chapter > header { grid-column: 1 / -1; margin-bottom: 0; }
  }

  @media (max-width: 58rem) {
    .installation { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
    .docs-sidebar { position: static; padding: 0 0 0.5rem; border-inline-end: 0; border-block-end: 1px solid var(--line); }
    .docs-sidebar ul { grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr)); }
  }

  .catalog-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--accent);
    font-size: 0.82rem;
  }

  .catalog-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .option {
    min-height: 2.5rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: var(--page);
    color: var(--text);
    font-size: 0.78rem;
  }

  .option:hover {
    border-color: var(--accent);
  }

  .doc-chapter {
    margin-top: 2.4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .guide-section > header {
    margin-bottom: 1rem;
  }

  h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.035em;
  }

  h3 { margin: 0; font-size: 0.98rem; font-weight: 650; }
  .package-section { margin-top: 1.35rem; }
  .topic { margin-top: 1.35rem; }
  .guide-section p { max-width: 70ch; }
  .guide-section .topic > p { margin: 0.35rem 0 0.65rem; }

  .props { width: 100%; border-collapse: collapse; text-align: start; font-size: 0.85rem; line-height: 1.55; }
  .props :is(th, td) { padding: 0.65rem 0.6rem; border-bottom: 1px solid var(--line); text-align: start; vertical-align: top; overflow-wrap: anywhere; }
  .props td { color: var(--muted); }
  .props code { color: var(--text); font-family: var(--font-mono); }

  .guide-section p,
  dd {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.83rem;
    line-height: 1.65;
  }

  fieldset {
    min-inline-size: 0;
    padding: 0;
    margin: 0 0 0.65rem;
    border: 0;
  }

  .option {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
  }

  input:checked + .option {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--hover);
  }

  input:focus-visible + .option {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  img {
    object-fit: contain;
  }

  .light-logo,
  :global(:root[data-theme="light"]) .dark-logo {
    display: none;
  }

  :global(:root[data-theme="light"]) .light-logo {
    display: block;
  }

  .examples {
    display: grid;
    gap: 0.75rem;
  }

  .examples:has(> :not([hidden])) {
    margin-block: 0.5rem 1rem;
  }

  .examples p {
    margin: 0;
    color: var(--muted);
    font-size: 0.83rem;
    line-height: 1.65;
  }

  .guide-section p code,
  .examples p code,
  dd code,
  .variants code {
    color: var(--text);
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
  }

  .variants {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .variants li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    background: var(--panel);
    color: var(--accent);
  }

  .variants strong,
  .variants code {
    display: block;
    color: var(--text);
    font-size: 0.8rem;
  }

  .variants code {
    margin-top: 0.2rem;
    color: var(--muted);
  }

  .guide-section .note {
    margin-top: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-inline-start: 1px solid var(--accent);
    background: var(--docs-tint);
  }

  .tips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem 1.25rem;
    margin-block: 1.2rem;
  }

  dt {
    font-size: 0.82rem;
    font-weight: 650;
  }

  @media (max-width: 36rem) {
    .options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .option { min-height: 2.75rem; }
    .doc-chapter { margin-top: 1.75rem; padding-top: 1.5rem; }
    .props :is(th, td) { padding-inline: 0.35rem; }
  }

  @media (max-width: 44rem) {
    .tips {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
