---
import Icon from "../icons/Icon.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import CodeSnippet from "../components/CodeSnippet.astro";
import InstallationExample from "../components/InstallationExample.astro";
import InstallationIntro from "../components/InstallationIntro.astro";
import ReactLogo from "../assets/frameworks/react.svg";
import AstroLogo from "../assets/frameworks/astro.svg";
import NextLogo from "../assets/frameworks/nextjs.svg";
import VueLogo from "../assets/frameworks/vue.svg";
import SvelteLogo from "../assets/frameworks/svelte.svg";
import BunLogo from "../assets/package-managers/bun.svg";
import NpmLogo from "../assets/package-managers/npm.svg";
import PnpmLogo from "../assets/package-managers/pnpm.svg";
import PnpmDarkLogo from "../assets/package-managers/pnpm_dark.svg";
import YarnLogo from "../assets/package-managers/yarn.svg";
import { localeFromPath, localizePath, pageTitle, t } from "../i18n/index.ts";

const locale = localeFromPath(Astro.url.pathname);
const packageName = "@ira/iraicons";
const reactPackage = `${packageName}-react`;
const managers = [
  { name: "npm", logo: NpmLogo, command: "npm install" },
  { name: "Bun", logo: BunLogo, command: "bun add" },
  {
    name: "pnpm",
    logo: PnpmLogo,
    darkLogo: PnpmDarkLogo,
    command: "pnpm add",
  },
  { name: "Yarn", logo: YarnLogo, command: "yarn add" },
];

const searchLabel = t(locale, "install.example.search");
const reactExample = `import { SearchMinimalist } from '${reactPackage}';

export default function SearchButton() {
  return (
    <button type="button" aria-label="${searchLabel}">
      <SearchMinimalist size={24} />
    </button>
  );
}`;

const astroExample = `---
import SearchMinimalist from '${packageName}-astro/search-minimalist';
---

<button type="button" aria-label="${searchLabel}">
  <SearchMinimalist size={24} />
</button>`;

const nextExample = `import SearchMinimalist from '${reactPackage}/search-minimalist';

export default function Page() {
  return <SearchMinimalist size={24} label="${searchLabel}" />;
}`;

const vueExample = `<script setup>
import { SearchMinimalist } from '${packageName}-vue';
</script>

<template>
  <SearchMinimalist :size="24" label="${searchLabel}" />
</template>`;

const svelteExample = `<script>
  import { SearchMinimalist } from '${packageName}-svelte';
</script>

<SearchMinimalist size={24} label="${searchLabel}" />`;

const htmlExample = `<button type="button" aria-label="${searchLabel}">
  <img src="/icons/search-minimalist.svg"
       width="24" height="24" alt="">
</button>`;

const variants = [
  { name: "search", label: t(locale, "variant.original") },
  { name: "search-minimalist", label: t(locale, "variant.minimalist") },
  { name: "search-animated", label: t(locale, "variant.animated") },
];
---

<SiteLayout
  title={pageTitle(t(locale, "meta.install.title"))}
  description={t(locale, "meta.install.description")}
>
  <main class="installation">
    <InstallationIntro packageName={packageName}>
      <div class="examples" data-install-examples>
        <InstallationExample id="react" title="React">
          <img slot="icon" src={ReactLogo.src} width="22" height="20" alt="" />
          <p slot="description">
            {t(locale, "install.react.lead")} <code>{reactPackage}</code>{t(locale, "install.react.end")}
          </p>
          <CodeSnippet
            title="SearchButton.jsx"
            code={reactExample}
            lang="jsx"
          />
        </InstallationExample>

        <InstallationExample id="astro" title="Astro">
          <img
            slot="icon"
            class="astro-framework-logo"
            src={AstroLogo.src}
            width="17"
            height="21"
            alt=""
          />
          <p slot="description">
            {t(locale, "install.astro.lead")} <code>.astro</code>{t(locale, "install.astro.mid")}<code>client:*</code>{t(locale, "install.astro.end")}
          </p>
          <CodeSnippet
            title="SearchButton.astro"
            code={astroExample}
            lang="astro"
          />
        </InstallationExample>

        <InstallationExample id="next" title="Next.js">
          <img
            slot="icon"
            class="next-framework-logo"
            src={NextLogo.src}
            width="20"
            height="20"
            alt=""
          />
          <p slot="description">
            {t(locale, "install.next.lead")}<code>'use client'</code>{t(locale, "install.next.end")}
          </p>
          <CodeSnippet title="app/page.jsx" code={nextExample} lang="jsx" />
        </InstallationExample>

        <InstallationExample id="vue" title="Vue 3">
          <img slot="icon" src={VueLogo.src} width="22" height="19" alt="" />
          <p slot="description">
            {t(locale, "install.vue.lead")}<code>&lt;script setup&gt;</code>{t(locale, "install.vue.end")}
          </p>
          <CodeSnippet title="SearchIcon.vue" code={vueExample} lang="vue" />
        </InstallationExample>

        <InstallationExample id="svelte" title="Svelte 5">
          <img slot="icon" src={SvelteLogo.src} width="17" height="21" alt="" />
          <p slot="description">
            {t(locale, "install.svelte.lead")}<code>.svelte</code>{t(locale, "install.svelte.end")}
          </p>
          <CodeSnippet
            title="SearchIcon.svelte"
            code={svelteExample}
            lang="svelte"
          />
        </InstallationExample>

        <InstallationExample id="svg" title="HTML / SVG">
          <Icon slot="icon" name="svg" size={23} />
          <p slot="description">
            {t(locale, "install.svg.lead")}<code>node_modules/{packageName}/icons/search-minimalist.svg</code>{t(locale, "install.svg.mid")}<code>icons/</code>{t(locale, "install.svg.afterFolder")}<strong>{t(locale, "install.svg.action")}</strong>{t(locale, "install.svg.end")}
          </p>
          <CodeSnippet title="index.html" code={htmlExample} lang="html" />
        </InstallationExample>
      </div>
    </InstallationIntro>

    <section class="guide-section" aria-labelledby="install-title">
      <header>
        <h2 id="install-title">{t(locale, "install.packages.title")}</h2>
        <p>{t(locale, "install.packages.lead")}</p>
      </header>

      <fieldset data-package-options hidden>
        <legend class="visually-hidden">{t(locale, "install.manager")}</legend>
        <div class="options">
          {managers.map(({ name, logo, darkLogo, command }, index) => (
            <label>
              <input
                class="visually-hidden"
                type="radio"
                name="package-manager"
                value={command}
                checked={index === 0}
              />
              <span class="option">
                <img
                  class:list={[{ "light-logo": darkLogo }]}
                  src={logo.src}
                  alt=""
                  width="18"
                  height="18"
                />
                {darkLogo && (
                  <img
                    class="dark-logo"
                    src={darkLogo.src}
                    alt=""
                    width="18"
                    height="18"
                  />
                )}
                {name}
              </span>
            </label>
          ))}
        </div>
      </fieldset>
      <div data-install-command data-package-base={packageName}>
        <CodeSnippet title="Terminal" code={`${managers[0].command} ${reactPackage}`} live />
      </div>
      <p class="note">
        {t(locale, "install.packages.beforeName")}<code>{packageName}</code>{t(locale, "install.packages.beforePath")}<code>{packageName}/astro</code>{t(locale, "install.packages.beforeCommand")}<code>bun run package:pack</code>{t(locale, "install.packages.beforeTgz")}<code>.tgz</code>{t(locale, "install.packages.end")}
      </p>
    </section>

    <section class="guide-section" aria-labelledby="customize-title">
      <header>
        <h2 id="customize-title">{t(locale, "install.style.title")}</h2>
        <p>{t(locale, "install.style.lead")}</p>
      </header>

      <ul class="variants">
        {variants.map(({ name, label }) => (
          <li>
            <Icon name={name} size={28} />
            <div>
              <strong>{label}</strong>
              <code>{name}</code>
            </div>
          </li>
        ))}
      </ul>

      <p class="note">
        {t(locale, "install.versions.lead")}<code>0.2.0</code>{t(locale, "install.versions.mid")}<code>0.3.0</code>{t(locale, "install.versions.end")}
      </p>

      <dl class="tips">
        <div>
          <dt>{t(locale, "install.tip.size")}</dt>
          <dd>
            {t(locale, "install.size.lead")}<code>size</code>{t(locale, "install.size.and")}<code>color</code>{t(locale, "install.size.end")}
          </dd>
        </div>
        <div>
          <dt>{t(locale, "install.tip.a11y")}</dt>
          <dd>
            {t(locale, "install.a11y.lead")}<code>label</code>{t(locale, "install.a11y.mid")}<code>alt</code>{t(locale, "install.a11y.end")}
          </dd>
        </div>
      </dl>

      <a class="catalog-link" href={localizePath("/", locale)}>
        {t(locale, "install.browse")}
        <Icon name="arrow-right-minimalist" size={16} />
      </a>
    </section>
  </main>
</SiteLayout>

<script src="../scripts/installation.ts"></script>

<style>
  .installation {
    max-width: 68rem;
    padding-bottom: 4rem;
  }

  .catalog-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--accent);
    font-size: 0.82rem;
  }

  .catalog-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .option {
    min-height: 2.5rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: var(--page);
    color: var(--text);
    font-size: 0.78rem;
  }

  .option:hover {
    border-color: var(--accent);
  }

  .guide-section + .guide-section {
    margin-top: 2.4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .guide-section > header {
    margin-bottom: 1rem;
  }

  h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.035em;
  }

  .guide-section p,
  dd {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.83rem;
    line-height: 1.65;
  }

  fieldset {
    min-inline-size: 0;
    padding: 0;
    margin: 0 0 0.65rem;
    border: 0;
  }

  .option {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
  }

  input:checked + .option {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--hover);
  }

  input:focus-visible + .option {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  img {
    object-fit: contain;
  }

  .light-logo,
  :global(:root[data-theme="light"]) .dark-logo {
    display: none;
  }

  :global(:root[data-theme="light"]) .light-logo {
    display: block;
  }

  .examples {
    display: grid;
    gap: 0.75rem;
  }

  .examples:has(> :not([hidden])) {
    margin-block: 0.5rem 1rem;
  }

  .examples p {
    margin: 0;
    color: var(--muted);
    font-size: 0.83rem;
    line-height: 1.65;
  }

  .guide-section p code,
  .examples p code,
  dd code,
  .variants code {
    color: var(--text);
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
  }

  .variants {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .variants li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    background: var(--panel);
    color: var(--accent);
  }

  .variants strong,
  .variants code {
    display: block;
    color: var(--text);
    font-size: 0.8rem;
  }

  .variants code {
    margin-top: 0.2rem;
    color: var(--muted);
  }

  .guide-section .note {
    margin-top: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-inline-start: 2px solid var(--accent);
    background: var(--panel);
  }

  .tips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem 1.25rem;
    margin-block: 1.2rem;
  }

  dt {
    font-size: 0.82rem;
    font-weight: 650;
  }

  @media (max-width: 36rem) {
    .options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .option { min-height: 2.75rem; }
    .guide-section + .guide-section { margin-top: 1.75rem; padding-top: 1.5rem; }
  }

  @media (max-width: 44rem) {
    .tips {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
