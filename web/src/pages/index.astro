---
/** Composes the searchable catalog and its interactive icon detail panel. */
import { iconNames } from "../icons/icons.mjs";
import SiteLayout from "../layouts/SiteLayout.astro";
import IconCatalog from "../components/IconCatalog.astro";
import IconDetails from "../components/IconDetails.astro";
import CategoryFilters from "../components/CategoryFilters.astro";
import { categoriesFor, categoryLabels } from '../../../scripts/icon-expansion/categories.mjs';

const catalogNames = iconNames.filter(
  (name) => !/-(animated|minimalist)$/.test(name),
);
const firstIcon = catalogNames[0];
const usedCategories = new Set(catalogNames.flatMap(categoriesFor));
const categories = Object.entries(categoryLabels)
  .filter(([id]) => usedCategories.has(id))
  .map(([id, label]) => ({ id, label }))
  .sort((a, b) => a.label.localeCompare(b.label));
---

<SiteLayout>
  <main>
    <div class="workspace" id="workspace">
      <IconCatalog names={catalogNames} selectedName={firstIcon} />
      <CategoryFilters categories={categories} />
      <div class="detail-column">
        <IconDetails name={`${firstIcon}-animated`} />
        <p class="detail-note">
          Many Ira Icons were designed with AI assistance. We test the SVGs for
          rendering, animation, and reduced-motion support.
        </p>
      </div>
    </div>
    <dialog class="detail-dialog" id="detail-dialog" aria-labelledby="detail-title"></dialog>
  </main>
  <footer class="catalog-footer">
    <p>
      Ira Icons is in active development. New icons and animations are added
      over time.
    </p>
  </footer>
  <script src="../scripts/catalog.js"></script>
</SiteLayout>

<style>
  .catalog-footer {
    max-width: 1800px;
    margin-inline: auto;
    padding: 1rem clamp(1rem, 3vw, 3rem) 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .catalog-footer p {
    margin: 0;
  }

  .detail-note {
    margin: 0.65rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
    text-align: end;
  }
</style>
