---
/** Composes the searchable catalog and its interactive icon detail panel. */
import { iconNames } from "../icons/icons.ts";
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../icons/Icon.astro";
import IconCatalog from "../components/IconCatalog.astro";
import IconDetails from "../components/IconDetails.astro";
import CategoryFilters from "../components/CategoryFilters.astro";
import { categoriesFor } from '../../../scripts/icon-expansion/categories.ts';
import { categoryLabel, localeFromPath, t } from '../i18n/index.ts';

const locale = localeFromPath(Astro.url.pathname);
const catalogNames = iconNames
  .filter((name) => !/-(animated|minimalist)$/.test(name))
  .sort((a, b) => Number(categoriesFor(b).includes('arrows')) - Number(categoriesFor(a).includes('arrows')));
const firstIcon = catalogNames[0];
const usedCategories = new Set(catalogNames.flatMap(categoriesFor));
const categories = [...usedCategories]
  .map((id) => ({ id, label: categoryLabel(locale, id) }))
  .sort((a, b) => a.label.localeCompare(b.label, locale));
---

<SiteLayout description={t(locale, "meta.catalog.description")}>
  <main>
    <div class="workspace" id="workspace">
      <IconCatalog names={catalogNames} selectedName={firstIcon}>
        <CategoryFilters slot="categories" categories={categories} />
      </IconCatalog>
      <div class="detail-column">
        <IconDetails name={`${firstIcon}-animated`} />
        <p class="detail-note">
          <span class="detail-note-icon" aria-hidden="true"><Icon name="alert-triangle-minimalist" size={16} /></span>
          <span>{t(locale, "catalog.note")}</span>
        </p>
      </div>
    </div>
    <dialog class="detail-dialog" id="detail-dialog" aria-labelledby="detail-title"></dialog>
  </main>
  <footer class="catalog-footer">
    <p>
      {t(locale, "catalog.footer")}
    </p>
  </footer>
  <script src="../scripts/catalog.ts"></script>
</SiteLayout>

<style>
  .catalog-footer {
    max-width: 1800px;
    margin-inline: auto;
    padding: 1rem clamp(1rem, 3vw, 3rem) 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .catalog-footer p {
    margin: 0;
  }

  .detail-note {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0.65rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
    text-align: start;
  }

  .detail-note-icon {
    display: inline-flex;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
</style>
