---
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import themeSource from "../scripts/theme.ts?raw";
import { transformWithEsbuild } from "vite";

// Keep the theme script synchronous in <head>, but strip TypeScript before inlining it.
const { code: themeScript } = await transformWithEsbuild(themeSource, "theme.ts", {
  loader: "ts", target: "es2022",
});

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ira Icons",
  description = "A minimal catalog of Ira outline SVG icons.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/ira-logo.png" />
    <title>{title}</title>
    <script is:inline set:html={themeScript}></script>
  </head>
  <body>
    <SiteHeader />
    <slot />
  </body>
</html>
