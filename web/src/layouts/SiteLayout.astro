---
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import themeScript from "../scripts/theme.js?raw";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ira Icons",
  description = "A minimal catalog of Ira outline SVG icons.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/ira-logo.png" />
    <title>{title}</title>
    <script is:inline set:html={themeScript}></script>
  </head>
  <body>
    <SiteHeader />
    <slot />
  </body>
</html>
