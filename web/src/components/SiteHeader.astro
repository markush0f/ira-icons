---
import Icon from "../icons/Icon.astro";
import LocaleFlag from "./LocaleFlag.astro";
import GitHubLogo from "../assets/frameworks/github.svg";
import { CREATE_COMING_SOON } from "../lib/feature-flags.ts";
import { localeFromPath, localizePath, locales, stripLocale, t, type Locale } from "../i18n/index.ts";

const locale = localeFromPath(Astro.url.pathname);
const path = stripLocale(Astro.url.pathname).replace(/\/$/, "") || "/";
const onCatalog = path === "/";
const onInstallation = path === "/installation";
const onCreate = path === "/create";
const href = (target: string) => localizePath(target, locale);
const switchTo = (code: Locale) => localizePath(`${stripLocale(Astro.url.pathname)}${Astro.url.search}`, code);
---

<header class="site-header">
  <a class="brand" href={href("/")} aria-label={t(locale, "nav.home")}>
    <img src="/ira-logo.png" alt="" width="65" height="65" />
    <span>Ira Icons</span>
  </a>

  <div class="header-actions">
    <a
      class="catalog-nav-link"
      href={href("/")}
      aria-label={t(locale, "nav.catalog.label")}
      data-astro-prefetch={onCatalog ? undefined : "hover"}
      aria-current={onCatalog ? "page" : undefined}
    >
      <Icon name="grid-minimalist" size={17} />
      <span class="nav-label">{t(locale, "nav.catalog")}</span>
    </a>
    <a
      class="create-link"
      href={href("/create")}
      aria-label={t(locale, CREATE_COMING_SOON ? "nav.create.soon.label" : "nav.create.label")}
      data-astro-prefetch={onCreate ? undefined : "hover"}
      aria-current={onCreate ? "page" : undefined}
    >
      <Icon name="star-minimalist" size={17} />
      <span class="nav-label">{t(locale, "nav.create")}</span>
      {CREATE_COMING_SOON && <span class="nav-soon" aria-hidden="true">{t(locale, "nav.soon")}</span>}
    </a>
    <a
      class="installation-link"
      href={href("/installation")}
      aria-label={t(locale, "nav.install.label")}
      data-astro-prefetch={onInstallation ? undefined : "hover"}
      aria-current={onInstallation ? "page" : undefined}
    >
      <Icon name="download" size={17} />
      <span class="nav-label">{t(locale, "nav.install")}</span>
    </a>
    <details class="locale-menu">
      <summary aria-label={`${t(locale, "locale.switch")}: ${t(locale, locale === "en" ? "locale.en" : "locale.es")}`}>
        <LocaleFlag locale={locale} id="trigger" />
        <Icon name="chevron-down-minimalist" size={14} />
      </summary>
      <div class="locale-options">
        {locales.map((code) => (
          <a
            href={switchTo(code)}
            lang={code}
            hreflang={code}
            aria-current={code === locale ? "true" : undefined}
            data-astro-prefetch={code === locale ? undefined : "hover"}
          >
            <LocaleFlag locale={code} id={`option-${code}`} />
            <span>{t(locale, code === "en" ? "locale.en" : "locale.es")}</span>
          </a>
        ))}
      </div>
    </details>
    <a
      class="github-link"
      href="https://github.com/markush0f/ira-icons"
      aria-label={t(locale, "nav.github")}
      target="_blank"
    >
      <img src={GitHubLogo.src} alt="" width="19" height="19" />
    </a>
    <button
      type="button"
      class="theme-button"
      id="theme-toggle"
      aria-label={t(locale, "nav.theme")}
      aria-pressed="false"
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <path
          d="M20.5 14.4A8.7 8.7 0 0 1 9.6 3.5 8.7 8.7 0 1 0 20.5 14.4Z"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  </div>
</header>

<script>
  const menuSelector = ".locale-menu";
  document.addEventListener("click", (event) => {
    const menu = document.querySelector(menuSelector);
    if (!(menu instanceof HTMLDetailsElement) || !menu.open) return;
    if (event.target instanceof Node && menu.contains(event.target)) return;
    menu.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const menu = document.querySelector(menuSelector);
    if (!(menu instanceof HTMLDetailsElement) || !menu.open) return;
    menu.open = false;
    menu.querySelector("summary")?.focus();
  });
</script>

<style>
  .locale-menu {
    position: relative;
  }

  .locale-menu summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    min-width: 2.25rem;
    min-height: 2.25rem;
    padding-inline: 0.35rem;
    border-radius: 0.35rem;
    color: var(--muted);
    list-style: none;
    cursor: pointer;
  }

  .locale-menu summary::-webkit-details-marker {
    display: none;
  }

  .locale-menu summary:hover,
  .locale-menu[open] summary {
    color: var(--text);
    background: var(--hover);
  }

  .locale-menu[open] summary :global(svg:last-child) {
    transform: rotate(180deg);
  }

  .locale-options {
    position: absolute;
    z-index: 3;
    top: calc(100% + 0.35rem);
    inset-inline-end: 0;
    display: grid;
    min-width: 9.5rem;
    padding: 0.3rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--panel);
  }

  .locale-options a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.55rem;
    border-radius: 0.35rem;
    font-size: 0.78rem;
  }

  .locale-options a:hover,
  .locale-options a[aria-current="true"] {
    background: var(--hover);
    color: var(--accent);
  }

  @media (max-width: 36rem) {
    .locale-menu summary,
    .locale-options a {
      min-height: 2.75rem;
    }
  }
</style>
