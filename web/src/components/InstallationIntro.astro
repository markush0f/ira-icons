---
import Icon from "../icons/Icon.astro";
import ReactLogo from "../assets/frameworks/react.svg";
import AstroLogo from "../assets/frameworks/astro.svg";
import NextLogo from "../assets/frameworks/nextjs.svg";
import VueLogo from "../assets/frameworks/vue.svg";
import SvelteLogo from "../assets/frameworks/svelte.svg";
import { localeFromPath, localizePath, t } from "../i18n/index.ts";

interface Props {
  packageName: string;
}

const { packageName } = Astro.props;
const specimenName = "coffee-animated";
const locale = localeFromPath(Astro.url.pathname);
const catalogHref = localizePath("/", locale);
---

<header class="intro">
  <a class="back-link" href={catalogHref}>
    <Icon name="arrow-left-minimalist" size={15} />
    {t(locale, "nav.back")}
  </a>

  <div class="heading">
    <div>
      <h1>{t(locale, "install.title")}</h1>
      <code class="package">{packageName}</code>
      <p>{t(locale, "install.lead")}</p>
    </div>

    <figure class="specimen" aria-hidden="true">
      <div class="specimen-grid">
        <Icon name={specimenName} constant={false} />
      </div>
      <figcaption><span>{specimenName}.svg</span><span>24 × 24</span></figcaption>
    </figure>
  </div>

</header>

<section class="install-examples" aria-labelledby="install-title">
  <h2 id="install-title">{t(locale, "docs.install")}</h2>
  <nav class="example-links" aria-label={t(locale, "install.examples.label")} data-install-example-links>
    <span aria-hidden="true">{t(locale, "install.examples")}</span>
    <a href="#react"><img src={ReactLogo.src} width="17" height="16" alt="" /> React</a>
    <a href="#astro"><img class="astro-framework-logo" src={AstroLogo.src} width="14" height="17" alt="" /> Astro</a>
    <a href="#next"><img class="next-framework-logo" src={NextLogo.src} width="17" height="17" alt="" /> Next.js</a>
    <a href="#vue"><img src={VueLogo.src} width="17" height="15" alt="" /> Vue</a>
    <a href="#svelte"><img src={SvelteLogo.src} width="14" height="17" alt="" /> Svelte</a>
    <a href="#svg"><Icon name="svg" size={19} /> HTML / SVG</a>
  </nav>
  <slot />
</section>

<style>
  .intro {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--line);
  }

  h2 { margin: 0 0 0.8rem; font-size: 1.25rem; font-weight: 650; letter-spacing: -0.03em; }

  .back-link,
  .example-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .back-link {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .back-link:hover,
  .example-links a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(4rem, 18vw, 11rem);
    align-items: center;
    gap: clamp(0.65rem, 4vw, 3rem);
    padding-block: clamp(1.25rem, 4vw, 2.75rem) 1.25rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.7rem, 5.8vw, 4.1rem);
    font-weight: 650;
    letter-spacing: -0.065em;
    line-height: 1.08;
  }

  .package {
    display: inline-block;
    margin-top: 0.6rem;
    color: var(--accent);
    font: clamp(0.72rem, 2.5vw, 0.92rem)/1.4 var(--font-mono);
    overflow-wrap: anywhere;
  }

  p {
    max-width: 49ch;
    margin: 0.8rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.65;
  }

  .specimen {
    margin: 0;
    color: var(--accent);
  }

  .specimen-grid {
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    padding: 10%;
    border: 1px solid var(--docs-edge, var(--line));
    border-radius: 0.65rem;
    background-color: var(--docs-tint, var(--panel));
    background-image: radial-gradient(circle at 50% 50%, var(--docs-edge, var(--line)) 1px, transparent 1.5px);
    background-size: 12.5% 12.5%;
  }

  .specimen-grid > :global(svg) {
    width: 84%;
    height: auto;
    aspect-ratio: 1;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem;
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.65rem;
  }

  .example-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: clamp(0.75rem, 4vw, 1.75rem);
    font-size: 0.8rem;
  }

  .example-links > span {
    color: var(--muted);
  }

  .example-links a {
    min-height: 2.75rem;
  }

  .example-links a[aria-current="true"] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 44rem) {
    figcaption > span:first-child {
      display: none;
    }

    figcaption {
      justify-content: center;
    }
  }

  @media (max-width: 36rem) {
    .example-links > span {
      display: none;
    }
  }
</style>
