---
import Icon from "../icons/Icon.astro";
import { MAX_REPORT_COMMENT_LENGTH } from "../lib/icon-report.ts";
import { localeFromPath, t } from "../i18n/index.ts";

const locale = localeFromPath(Astro.url.pathname);
---

<form class="report" data-icon-report hidden>
  <p class="report-hint" id="icon-report-hint">
    {t(locale, "report.hint")}
  </p>
  <details class="report-comment" data-report-comment-panel>
    <summary>{t(locale, "report.addComment")}</summary>
    <label class="visually-hidden" for="icon-report-comment">{t(locale, "report.comment")}</label>
    <textarea
      id="icon-report-comment"
      data-report-comment
      maxlength={MAX_REPORT_COMMENT_LENGTH}
      rows="3"
      placeholder={t(locale, "report.placeholder")}
      aria-describedby="icon-report-comment-hint"
    ></textarea>
    <p id="icon-report-comment-hint" class="report-hint">{t(locale, "report.limit", { max: MAX_REPORT_COMMENT_LENGTH })}</p>
  </details>
  <button type="submit" data-report-button aria-describedby="icon-report-hint">
    <Icon name="flag-minimalist" size={16} />
    {t(locale, "report.submit")}
  </button>
  <span role="status" data-report-status></span>
</form>

<style>
  .report {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem 0.75rem;
    margin-top: 1rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    font-size: 0.76rem;
  }

  .report-hint {
    flex-basis: 100%;
    margin: 0;
    color: var(--muted);
    line-height: 1.5;
  }

  .report-comment {
    flex-basis: 100%;
  }

  summary {
    width: fit-content;
    padding-block: 0.3rem;
    color: var(--muted);
    cursor: pointer;
  }

  summary:hover {
    color: var(--accent);
  }

  textarea {
    display: block;
    width: 100%;
    margin-block: 0.35rem;
    padding: 0.5rem 0.6rem;
    resize: vertical;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: var(--page);
    color: var(--text);
    font: inherit;
    line-height: 1.5;
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding-inline: 0.6rem;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  @media (max-width: 36rem) {
    summary, button { min-height: 2.75rem; }
    summary { padding-block: 0.75rem; }
    textarea { font-size: 1rem; }
  }

  button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--text);
  }

  button:disabled {
    opacity: 0.7;
    cursor: default;
  }
</style>
