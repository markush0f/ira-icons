---
import Icon from "../icons/Icon.astro";
import ReactLogo from "../assets/frameworks/react.svg";
import NextLogo from "../assets/frameworks/nextjs.svg";
import AstroLogo from "../assets/frameworks/astro.svg";
import VueLogo from "../assets/frameworks/vue.svg";
import SvelteLogo from "../assets/frameworks/svelte.svg";
import { type CodeFormat } from "../scripts/icon-copy.ts";
import { localeFromPath, t } from "../i18n/index.ts";

const locale = localeFromPath(Astro.url.pathname);
const variants = [
  [t(locale, "variant.animated"), "-animated"],
  [t(locale, "variant.original"), ""],
  [t(locale, "variant.minimalist"), "-minimalist"],
] as const;

const formats = [
  { name: "React", logo: ReactLogo },
  { name: "Next.js", logo: NextLogo, class: "next-framework-logo" },
  { name: "Astro", logo: AstroLogo, class: "astro-framework-logo" },
  { name: "Vue", logo: VueLogo },
  { name: "Svelte", logo: SvelteLogo },
  { name: "SVG", logo: null },
] satisfies { name: CodeFormat; logo: ImageMetadata | null; class?: string }[];
---

<div data-icon-copy hidden>
  <div class="detail-divider"></div>
  <div class="detail-actions">
    <div>
      <div class="copy-heading">
        <p class="detail-eyebrow" id="copy-label">
          {t(locale, "copy.as")}
        </p>
        <span
          class="detail-eyebrow copy-status"
          role="status"
          data-copy-status
        ></span>
      </div>
      <div class="framework-links" role="group" aria-labelledby="copy-label">
        {formats.map((format) => (
          <button
            class="framework-button"
            type="button"
            data-copy-format={format.name}
            aria-label={t(locale, "copy.named", { name: format.name })}
            title={t(locale, "copy.named", { name: format.name })}
          >
            {format.logo ? (
              <img
                class={format.class}
                src={format.logo.src}
                alt=""
                width="18"
                height="18"
              />
            ) : (
              <Icon name="svg" size={20} />
            )}
          </button>
        ))}
      </div>
    </div>
    <div data-variant-picker>
      <p class="detail-eyebrow" id="variant-label">
        {t(locale, "copy.variant")}
      </p>
      <div class="variant-options" role="group" aria-labelledby="variant-label">
        {variants.map(([label, suffix]) => (
          <button
            class="framework-button variant-button"
            type="button"
            data-suffix={suffix}
            aria-pressed="false"
          >
            {label}
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .copy-heading {
    display: grid;
  }
  .copy-heading > * {
    grid-area: 1 / 1;
  }
  .copy-heading:has(.copy-status:not(:empty)) #copy-label {
    clip-path: inset(50%);
  }
  .framework-links {
    flex-wrap: wrap;
  }
  .variant-options .variant-button {
    width: auto;
    padding-inline: .65rem;
    font: 500 .75rem var(--font-mono);
  }
</style>
