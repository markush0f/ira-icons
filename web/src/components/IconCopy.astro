---
import Icon from "../icons/Icon.astro";
import ReactLogo from "../assets/frameworks/react.svg";
import NextLogo from "../assets/frameworks/nextjs.svg";
import AstroLogo from "../assets/frameworks/astro.svg";
import VueLogo from "../assets/frameworks/vue.svg";
import SvelteLogo from "../assets/frameworks/svelte.svg";
import { type CodeFormat } from "../scripts/icon-copy.ts";

const formats = [
  { name: "React", logo: ReactLogo },
  { name: "Next.js", logo: NextLogo, class: "next-framework-logo" },
  { name: "Astro", logo: AstroLogo, class: "astro-framework-logo" },
  { name: "Vue", logo: VueLogo },
  { name: "Svelte", logo: SvelteLogo },
  { name: "SVG", logo: null },
] satisfies { name: CodeFormat; logo: ImageMetadata | null; class?: string }[];
---

<div data-icon-copy hidden>
  <div class="detail-divider"></div>
  <div class="detail-actions">
    <div>
      <div class="copy-heading">
        <p class="detail-eyebrow" id="copy-label">Copy as</p>
        <span class="detail-eyebrow copy-status" role="status" data-copy-status></span>
      </div>
      <div class="framework-links" role="group" aria-labelledby="copy-label">
        {formats.map((format) => (
          <button class="framework-button" type="button" data-copy-format={format.name}
            aria-label={`Copy ${format.name}`} title={`Copy ${format.name}`}>
            {format.logo ? <img class={format.class} src={format.logo.src} alt="" width="18" height="18" /> : <Icon name="svg" size={20} />}
          </button>
        ))}
      </div>
    </div>
    <div data-variant-picker>
      <p class="detail-eyebrow" id="variant-label">Variante</p>
      <div class="variant-options" role="group" aria-labelledby="variant-label">
        {[["Animado", "-animated", "play"], ["Minimalista", "-minimalist", "minus"], ["Normal", "", "square"]].map(([label, suffix, glyph]) => (
          <button class="framework-button" type="button" data-suffix={suffix} aria-label={label} title={label} aria-pressed="false">
            <Icon name={glyph} size={19} />
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .copy-heading { display: grid; }
  .copy-heading > * { grid-area: 1 / 1; }
  .copy-heading:has(.copy-status:not(:empty)) #copy-label { clip-path: inset(50%); }
  .framework-links { flex-wrap: wrap; }
</style>
