---
import Icon from "../icons/Icon.astro";
import IconCard from "./IconCard.astro";
import { categoriesFor } from '../../../scripts/icon-expansion/categories.mjs';

interface Props {
  names: readonly string[];
  selectedName: string;
}

const { names, selectedName } = Astro.props;
const pageSize = 48;
const memberships = names.map(name => categoriesFor(name).join(','));

---

<section class="catalog-panel" aria-labelledby="catalog-title">
  <div class="catalog-header">
    <div class="catalog-heading">
      <h1 class="visually-hidden" id="catalog-title">
        Icon catalog
      </h1>
      <p id="icon-count" role="status">
        {names.length} icons
      </p>
    </div>
    <div class="search-field" id="search-field" hidden>
      <Icon name="search" size={17} />
      <label class="visually-hidden" for="icon-search">
        Search icons
      </label>
      <input
        type="search"
        id="icon-search"
        placeholder="Search icons"
        autocomplete="off"
        aria-controls="icon-grid"
      />
    </div>
  </div>

  <ul class="icon-grid" id="icon-grid" role="list" data-page-size={pageSize} data-names={names.join(' ')} data-categories={memberships.join(' ')}>
    {names.slice(0, pageSize).map((name) => (
      <IconCard name={name} selected={name === selectedName} />
    ))}
  </ul>
  <p class="empty-state" id="empty-state" hidden>
    No icons found.
  </p>
  <div class="catalog-loader" id="catalog-loader" hidden>
    <p role="status" data-loaded-count></p>
    <button type="button" data-load-more aria-controls="icon-grid">Load more <Icon name="chevron-down" size={16} /></button>
  </div>
</section>
<style>
  .catalog-loader { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .65rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--muted); font: .78rem var(--font-mono); }
  .catalog-loader p { margin: 0; }
  .catalog-loader button { display: inline-flex; align-items: center; gap: .4rem; min-height: 2.5rem; padding-inline: .65rem; border: 1px solid var(--line); border-radius: .5rem; background: var(--panel); color: var(--text); cursor: pointer; }
  .catalog-loader button:hover { border-color: var(--accent); background: var(--hover); }
</style>
