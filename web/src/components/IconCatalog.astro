---
import Icon from "../icons/Icon.astro";
import IconCard from "./IconCard.astro";
import { categoriesFor, categoryLabels } from '../../../scripts/icon-expansion/categories.mjs';

interface Props {
  names: readonly string[];
  selectedName: string;
}

const { names, selectedName } = Astro.props;
const pageSize = 48;
const ids = Object.keys(categoryLabels);
const masks = names.map(name => categoriesFor(name).reduce((mask, id) => mask | (1 << ids.indexOf(id)), 0));
const categories = ids.map((id, index) => ({id, label: categoryLabels[id], bit: 1 << index}))
  .filter(({bit}) => masks.some(mask => mask & bit)).sort((a,b) => a.label.localeCompare(b.label));
---

<section class="catalog-panel" aria-labelledby="catalog-title">
  <div class="catalog-header">
    <div class="catalog-heading">
      <h1 class="visually-hidden" id="catalog-title">
        Icon catalog
      </h1>
      <p id="icon-count" role="status">
        {names.length} icons
      </p>
      <nav aria-label="New collections"><a href="/folio.html">Folio</a> · <a href="/atlas.html">Atlas</a></nav>
    </div>
    <div class="search-field" id="search-field" hidden>
      <Icon name="search" size={17} />
      <label class="visually-hidden" for="icon-search">
        Search icons
      </label>
      <input
        type="search"
        id="icon-search"
        placeholder="Search icons"
        autocomplete="off"
        aria-controls="icon-grid"
      />
    </div>
  </div>

  <details id="catalog-categories" hidden>
    <summary>Categories <span data-category-count></span></summary>
    <p>Show icons in any selected category.</p>
    <fieldset aria-label="Filter by category">
      {categories.map(({id, label, bit}) => (
        <label><input type="checkbox" value={id} data-bit={bit} /> {label}</label>
      ))}
    </fieldset>
    <button type="button" data-clear-categories>Clear categories</button>
  </details>
  <nav id="catalog-pager" aria-label="Catalog pages" hidden>
    <button type="button" data-prev>Previous</button>
    <span aria-live="polite" data-page></span>
    <button type="button" data-next>Next</button>
  </nav>
  <ul class="icon-grid" id="icon-grid" role="list" data-page-size={pageSize} data-names={names.join(' ')} data-categories={masks.map(mask => mask.toString(36)).join(' ')}>
    {names.slice(0, pageSize).map((name) => (
      <IconCard name={name} selected={name === selectedName} />
    ))}
  </ul>
  <p class="empty-state" id="empty-state" hidden>
    No icons found.
  </p>
</section>
<style>
  #catalog-categories { margin-block: .65rem; }
  summary { cursor: pointer; }
  fieldset { display: flex; flex-wrap: wrap; gap: .35rem 1rem; padding: 0; border: 0; margin-bottom: .65rem; }
  fieldset label { display: flex; align-items: center; gap: .25rem; }
</style>
