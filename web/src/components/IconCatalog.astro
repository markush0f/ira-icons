---
import Icon from "../icons/Icon.astro";
import IconCard from "./IconCard.astro";

interface Props {
  names: readonly string[];
  selectedName: string;
}

const { names, selectedName } = Astro.props;
const pageSize = 48;
---

<section class="catalog-panel" aria-labelledby="catalog-title">
  <div class="catalog-header">
    <div class="catalog-heading">
      <h1 class="visually-hidden" id="catalog-title">
        Icon catalog
      </h1>
      <p id="icon-count" role="status">
        {names.length} icons
      </p>
      <nav aria-label="New collections"><a href="/folio.html">Folio</a> · <a href="/atlas.html">Atlas</a></nav>
    </div>
    <div class="search-field" id="search-field" hidden>
      <Icon name="search" size={17} />
      <label class="visually-hidden" for="icon-search">
        Search icons
      </label>
      <input
        type="search"
        id="icon-search"
        placeholder="Search icons"
        autocomplete="off"
        aria-controls="icon-grid"
      />
    </div>
  </div>

  <nav id="catalog-pager" aria-label="Catalog pages" hidden>
    <button type="button" data-prev>Previous</button>
    <span aria-live="polite" data-page></span>
    <button type="button" data-next>Next</button>
  </nav>
  <ul class="icon-grid" id="icon-grid" role="list" data-page-size={pageSize} data-names={names.join(' ')}>
    {names.slice(0, pageSize).map((name) => (
      <IconCard name={name} selected={name === selectedName} />
    ))}
  </ul>
  <p class="empty-state" id="empty-state" hidden>
    No icons found.
  </p>
</section>
