---
interface Props { name: string; selected?: boolean }
const { name, selected = false } = Astro.props;
---
<li class:list={['icon-card', { 'is-selected': selected }]} data-family={name}>
  <button class="icon-select" type="button" data-select-icon aria-controls="detail-panel" aria-expanded={selected}>
    <span class="icon-preview"><img src={`/icons/${name}.svg`} alt="" width="40" height="40" loading="lazy" decoding="async" /></span>
    <span class="icon-name">{name}</span>
  </button>
</li>
<style>.icon-preview img { filter: brightness(0) saturate(100%) invert(65%) sepia(56%) saturate(1500%) hue-rotate(212deg); }</style>
