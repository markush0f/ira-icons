---
import Icon from "../icons/Icon.astro";
import ColorPicker from "./ColorPicker.astro";
import SpeedPicker from "./SpeedPicker.astro";
import IconCopy from "./IconCopy.astro";
import IconReport from "./IconReport.astro";
import { CREATE_COMING_SOON } from "../lib/feature-flags.ts";

interface Props {
  name: string;
}

const { name } = Astro.props;
---

<aside
  class="detail-panel"
  id="detail-panel"
  tabindex="-1"
  aria-labelledby="detail-title"
>
  <div class="detail-header">
    <p class="detail-eyebrow">Icon details</p>
    <form method="dialog" class="detail-dialog-close">
      <button type="submit" aria-label="Close details" autofocus>
        <Icon name="close-minimalist" size={18} />
      </button>
    </form>
  </div>
  <div class="detail-preview" id="detail-preview">
    <Icon name={name} size={144} color="#ad8af3" />
  </div>
  <h2 class="detail-title" id="detail-title">
    {name}
  </h2>
  <ul class="detail-categories" aria-label="Icon categories" data-detail-categories hidden></ul>
  <IconCopy />
  <div class="detail-controls">
    <ColorPicker />
    <SpeedPicker animated={name.endsWith('-animated')} />
  </div>
  {!CREATE_COMING_SOON && <IconReport />}
</aside>
<style>
  .detail-controls { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; margin-top: 1rem; }
  .detail-controls:has([data-speed-picker]:not([hidden])) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 22rem) {
    .detail-controls:has([data-speed-picker]:not([hidden])) { grid-template-columns: minmax(0, 1fr); }
  }
</style>
<style is:global>
  .detail-categories { display: flex; flex-wrap: wrap; gap: .4rem; padding: 0; list-style: none; }
  .detail-categories li { border: 1px solid var(--line); border-radius: 1rem; padding: .2rem .55rem; font-size: .75rem; }
</style>
