---
/** A reusable color picker with a native spectrum control, HEX input, and palette presets. */
import { localeFromPath, t } from "../i18n/index.ts";
interface Props { initialColor?: string }
const { initialColor = "#ad8af3" } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const presets = ["#ad8af3", "#8b5cf6", "#58c4dc", "#f97316", "#ef4444", "#f2f2f2"];
---

<div class="color-picker" data-color-picker data-color={initialColor} style={`--picker-color: ${initialColor}`}>
  <label class="detail-eyebrow" for="detail-color">{t(locale, "color.label")}</label>
  <div class="color-picker-fields">
    <label class="color-swatch" for="detail-color-spectrum" aria-label={t(locale, "color.choose")}>
      <input id="detail-color-spectrum" type="color" value={initialColor} data-color-spectrum />
    </label>
    <label class="color-hex-field" for="detail-color">
      <span aria-hidden="true">#</span>
      <input id="detail-color" type="text" value={initialColor.slice(1)} maxlength="6" spellcheck="false" autocomplete="off" data-color-hex aria-label={t(locale, "color.hex")} />
    </label>
  </div>
  <div class="color-presets" aria-label={t(locale, "color.presets")}>
    {presets.map((color) => (
      <button type="button" class="color-preset" data-color-preset={color} style={`--preset-color: ${color}`} aria-label={t(locale, "color.use", { color })} title={color}></button>
    ))}
  </div>
</div>

<script>
  // Keep the spectrum input, HEX field, and presets in sync, then notify the selected icon.
  import { requireElement } from '../scripts/dom.ts';
  import { onPageLoad } from '../scripts/page-load.ts';
  const bound = new WeakSet<HTMLElement>();

  function bindPicker() {
  const picker = document.querySelector<HTMLElement>("[data-color-picker]");
  if (!picker || bound.has(picker)) return;
  bound.add(picker);
    const spectrum = requireElement<HTMLInputElement>("[data-color-spectrum]", picker);
    const hex = requireElement<HTMLInputElement>("[data-color-hex]", picker);

    const applyColor = (value: string) => {
      if (!/^#[\da-f]{6}$/i.test(value)) return;
      const color = value.toLowerCase();
      picker.dataset.color = color;
      picker.style.setProperty("--picker-color", color);
      spectrum.value = color;
      hex.value = color.slice(1);
      picker.dispatchEvent(new CustomEvent("icon-color-change", {
        bubbles: true,
        detail: { color },
      }));
    };

    spectrum.addEventListener("input", () => applyColor(spectrum.value));
    hex.addEventListener("input", () => {
      if (/^[\da-f]{6}$/i.test(hex.value)) applyColor(`#${hex.value}`);
    });
    hex.addEventListener("blur", () => {
      if (!/^[\da-f]{6}$/i.test(hex.value)) hex.value = picker.dataset.color!.slice(1);
    });
    picker.querySelectorAll<HTMLButtonElement>("[data-color-preset]").forEach((button) => {
      button.addEventListener("click", () => applyColor(button.dataset.colorPreset!));
    });
  }

  onPageLoad(bindPicker);
</script>
